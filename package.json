{
  "name": "good-time",
  "private": true,
  "version": "0.7.0",
  "description": "A single-player game about serving a sentence in a Washington State prison.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "io.github.felixdallesandro.goodtime",
    "productName": "Good Time",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Good-Time-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Good-Time-${version}-windows-portable.${ext}"
    }
  }
}
